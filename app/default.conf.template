server {
    listen 80;
    server_name _;

    location = /health {
        default_type text/plain;
        return 200 "OK\n";
    }

    location = /version {
        default_type text/plain;
        return 200 "${APP_VERSION}\n";
    }

    location / {
        default_type text/plain;
        return 200 "Sohyeon Jenkins + Ansible CI/CD\n";
    }
}